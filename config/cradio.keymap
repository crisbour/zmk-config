#undef ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE_L  0
#define NUM_L  1
#define SYM_L   2
#define NAV_L   3
#define MACRO_L 4
#define MEDIA_L 5

/* Tapping term for hold-tap behaviors */
#define TAPPING_TERM 200

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };

        /* Layer tap for thumb keys */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        web_prev: web_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp LEFT>,  <&macro_release &kp LALT>;
        };

        web_next: web_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp RIGHT>,  <&macro_release &kp LALT>;
        };

        pscn_save: pscn_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp PSCRN>,  <&macro_release &kp LGUI>;
        };

        pscn_tool: pscn_tool {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>, <&macro_tap &kp PSCRN>,  <&macro_release &kp LGUI &kp LSHFT>;
        };

        pscn_tex: pscn_tex {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LGUI &kp LALT>, <&macro_tap &kp PSCRN>,  <&macro_release &kp LGUI &kp LALT>;
        };

        /* Vim commands as single key behaviors */
        vim_vsplit: vim_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp V &kp S &kp P &kp L &kp I &kp T &kp ENTER>;
        };

        vim_save: vim_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp W &kp ENTER>;
        };

        vim_gvd: vim_gvd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp G &kp V &kp D &kp I &kp F &kp F &kp S &kp P &kp L &kp I &kp T &kp ENTER>;
        };

        vim_diff: vim_diff {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LGUI &kp LCTRL &kp PSCRN>;
        };

        /* Tmux commands */
        tmux_new: tmux_new {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp C>;
        };

        tmux_prev: tmux_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp P>;
        };

        tmux_next: tmux_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp N>;
        };

        tmux_pane_l: tmux_pane_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp H>;
        };

        tmux_pane_r: tmux_pane_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp L>;
        };

        tmux_pane_d: tmux_pane_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp J>;
        };

        tmux_pane_u: tmux_pane_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,  <&macro_release &kp LCTRL>, <&macro_tap &kp K>;
        };

        tmux_resize_l: tmux_resize_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL &kp B>, <&macro_tap &kp LEFT>,  <&macro_release &kp LCTRL &kp B>;
        };

        tmux_resize_r: tmux_resize_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LCTRL &kp B>, <&macro_tap &kp RIGHT>,  <&macro_release &kp LCTRL &kp B>;
        };

        aux_brit_up: aux_brit_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C_BRI_UP>,  <&macro_release &kp LGUI>;
        };

        aux_brit_dn: aux_brit_dn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C_BRI_DN>,  <&macro_release &kp LGUI>;
        };
    };

    combos {
      #include "combos.dtsi"
      /* Combo: Space + Backspace -> MACRO_L */
      space_backspace_macro {
          timeout-ms = <500>; /* Time window to press both keys */
          bindings = <&mo MACRO_L>;
          key-positions = <31 32>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                /* Left hand */                /* Right hand */
                &kp Q         &kp W           &kp E          &kp R      &kp T &kp Y &kp U      &kp I          &kp O   &kp P
                &hm LCTL A    &hm LSHFT S     &kp D          &kp F      &kp G &kp H &kp J      &kp K          &kp L   &hm LCTRL SEMI
                &kp Z         &kp X           &hm LGUI C     &hm LALT V &kp B &kp N &hm LALT M &hm LGUI COMMA &kp DOT &kp FSLH
                &lt NAV_L TAB &mt LSHFT SPACE &lt_repeat SYM_L BSPC &lt_repeat NUM_L ENTER
            >;
        };

        /*
         * FUNCTION LAYER (Layer 1)
         * F-keys and numbers
         */
        numbers {
            display-name = "Function";
            bindings = <
                &kp F1      &kp F2  &kp F3  &kp F4  &kp FSLH     &kp ASTRK &kp N7 &kp N8 &kp N9 &kp EQUAL
                &kp F5      &kp F6  &kp F7  &kp F8  &kp MINUS    &kp PLUS  &kp N4 &kp N5 &kp N6 &kp N0
                &kp F9      &kp F10 &kp F11 &kp F12 &kp COMMA    &kp DOT   &kp N1 &kp N2 &kp N3 &kp N0
                &mo MEDIA_L &trans  &trans  &trans
            >;
        };

        /*
         * SYMBOL LAYER (Layer 2)
         * Shifted numbers and symbols
         */
        symbol {
            display-name = "Symbol";
            bindings = <
                &kp TILDE &kp DQT     &kp LBRC &kp RBRC       &kp PRCNT &kp LT   &kp LBKT       &kp RBKT  &kp GT   &kp SQT
                &kp GRAVE &kp HASH    &kp LPAR &kp RPAR       &kp CARET &kp DLLR &kp MINUS      &kp EQUAL &kp PIPE &kp COLON
                &trans    &kp EXCL    &kp AMPS &mt LALT ASTRK &kp N0    &kp AT   &kp UNDERSCORE &kp PLUS  &kp BSLH &kp QMARK
                &trans    &mo MACRO_L &trans   &trans
            >;
        };

        /*
         * NAVIGATION LAYER (Layer 3)
         * Arrow keys, navigation, and vim macros
         */
        navigation {
            display-name = "Navigation";
            bindings = <
                &trans  &kp L      &kp M       &kp P          &kp U         &kp HOME         &kp PG_DN      &kp PG_UP   &kp END    &trans
                &trans  &kp ESC    &kp TAB     &kp CAPS       &kp DEL       &kp LEFT         &kp DOWN       &kp UP      &kp RIGHT  &kp COLON
                &pscn_tool &pscn_tex &kp PSCRN &pscn_save &trans &trans   &web_prev &web_next &trans &trans
                                                  &trans      &trans      &trans        &mo MEDIA_L
            >;
        };

        /*
         * MACRO LAYER (Layer 4)
         * Additional vim and tmux macros
         */
        macro_layer {
            display-name = "Macro";
            bindings = <
                &trans  &trans  &trans   &trans      &trans     &trans        &trans       &trans       &trans       &trans
                &trans  &trans  &trans   &trans      &trans     &tmux_pane_l  &tmux_pane_d &tmux_pane_u &tmux_pane_r &trans
                &trans  &vim_gvd &trans  &trans      &trans     &trans        &tmux_prev   &tmux_next   &tmux_resize_l &tmux_resize_r
                                                  &trans      &trans      &trans        &trans
            >;
        };

        /*
         * MEDIA LAYER (Layer 5)
         * Media controls and brightness
         */
        media {
            display-name = "Media";
            bindings = <
                &studio_unlock &bt BT_CLR  &trans   &trans    &kp C_BRI_UP &aux_brit_up &kp C_PREV &kp C_NEXT &kp C_PLAY_PAUSE &trans
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp C_BRI_DN &aux_brit_dn &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &trans
                &trans  &trans  &trans   &trans      &trans     &trans      &trans      &trans   &trans  &trans
                                                  &trans      &trans      &trans        &trans
            >;
        };

        /*

        num_layer {
            bindings = <
                &kp LBKT   &kp N7     &kp N8      &kp N9          &kp RBKT      &trans          &trans         &trans      &trans     &trans
                &kp SEMI   &kp N4     &kp N5      &kp N6          &kp EQUAL     &trans          &trans         &trans      &trans     &trans
                &kp GRAVE  &kp N1     &kp N2      &kp N3          &kp BSLH      &trans          &trans         &trans      &trans     &trans
                                                  &kp N0          &kp MINUS     &trans          &trans
            >;
        };

        sym_layer {
            bindings = <
                &kp LBRC     &kp LS(N7)  &kp LS(N8)  &kp LS(N9) &kp RBRC       &trans &trans   &trans    &trans    &trans
                &kp COLON     &kp LS(N4)  &kp LS(N5)  &kp LS(N6) &kp PLUS       &trans &trans   &trans    &trans    &trans
                &kp TILDE     &kp LS(N1)  &kp LS(N2)  &kp LS(N3) &kp LS(BSLH)       &trans &trans   &trans    &trans    &trans
                                                   &kp LS(N0) &kp UNDER   &trans &trans
            >;
        };
        */
    };
};
