#undef ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE_L  0
#define NUM_L  1
#define SYM_L   2
#define NAV_L   3
#define MACRO_L 4
#define MEDIA_L 5

/* Tapping term for hold-tap behaviors */
#define TAPPING_TERM 200

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Layer tap for thumb keys */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            bindings = <&kp>, <&mo>;
        };
    };

    macros {

        /* Vim commands as single key behaviors */
        vim_vsplit: vim_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp V &kp S &kp P &kp L &kp I &kp T &kp ENTER>;
        };

        vim_save: vim_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp W &kp ENTER>;
        };

        vim_gvd: vim_gvd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp ESC &kp COLON &kp G &kp V &kp D &kp I &kp F &kp F &kp S &kp P &kp L &kp I &kp T &kp ENTER>;
        };

        vim_snap: vim_snap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LGUI &kp PSCRN>;
        };

        vim_ss: vim_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LGUI &kp LSHFT &kp PSCRN>;
        };

        vim_diff: vim_diff {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LGUI &kp LCTRL &kp PSCRN>;
        };

        /* Tmux commands */
        tmux_new: tmux_new {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp N>;
        };

        tmux_prev: tmux_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp P>;
        };

        tmux_next: tmux_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp N>;
        };

        tmux_pane_l: tmux_pane_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp H>;
        };

        tmux_pane_r: tmux_pane_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp L>;
        };

        tmux_pane_d: tmux_pane_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp J>;
        };

        tmux_pane_u: tmux_pane_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LCTRL &kp B &kp K>;
        };
    };

    combos {
      #include "combos.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                /* Left hand */                /* Right hand */
                &kp Q      &kp W      &kp E       &kp R          &kp T         &kp Y            &kp U          &kp I       &kp O      &kp P
                &hm LCTL A &hm LSHFT S &kp D       &kp F          &kp G         &kp H            &kp J  &kp K &kp L &hm LCTRL SQT
                &kp Z      &kp X      &hm LGUI C       &hm LALT V          &kp B         &kp N            &hm LALT M          &hm LGUI COMMA   &kp DOT    &kp FSLH
                                                  &lt NAV_L TAB  &hm LSHFT SPACE &lt SYM_L BSPC &lt NUM_L ENTER
            >;
        };

        /*
         * FUNCTION LAYER (Layer 1)
         * F-keys and numbers
         */
        numbers {
            display-name = "Function";
            bindings = <
                &kp F1     &kp F2     &kp F3      &kp F4         &kp FSLH      &kp LS(N8)       &kp N7         &kp N8      &kp N9     &kp MINUS
                &kp F5     &kp F6     &kp F7      &kp F8         &trans     &kp N0           &kp N4         &kp N5      &kp N6     &kp LS(EQUAL)
                &kp F9     &kp F10    &kp F11     &kp F12        &kp COMMA     &kp DOT          &kp N1         &kp N2      &kp N3     &trans
                                                  &trans &trans &trans &trans
            >;
        };

        /*
         * SYMBOL LAYER (Layer 2)
         * Shifted numbers and symbols
         */
        symbol {
            display-name = "Symbol";
            bindings = <
                &kp LS(N1) &kp LS(N2) &kp LS(N3)  &kp LS(N4)     &kp LS(N5)    &kp LS(N6)       &kp LS(N7)     &kp LS(N8)  &kp GRAVE  &kp LS(GRAVE)
                &kp LS(SQT)&kp LS(COMMA)&kp LS(N9)&kp LBKT       &kp LS(LBKT)  &kp N0           &kp MINUS      &kp EQUAL   &kp LS(BSLH)&kp LS(SEMI)
                &kp SQT    &kp LS(DOT)&kp LS(N0) &kp RBKT       &kp LS(RBKT)  &kp LS(N4)       &kp LS(MINUS)  &kp LS(EQUAL)&kp BSLH  &kp LS(FSLH)
                                                  &trans  &lt MACRO_L SPACE &trans &trans
            >;
        };

        /*
         * NAVIGATION LAYER (Layer 3)
         * Arrow keys, navigation, and vim macros
         */
        navigation {
            display-name = "Navigation";
            bindings = <
                &trans  &kp L      &kp M       &kp P          &kp U         &kp HOME         &kp PG_DN      &kp PG_UP   &kp END    &trans
                &trans  &kp ESC    &kp TAB     &kp CAPS       &kp DEL       &kp LEFT         &kp DOWN       &kp UP      &kp RIGHT  &kp LS(SEMI)
                &vim_snap &vim_ss &kp PSCRN &vim_diff   &vim_save  &trans        &tmux_pane_d &tmux_pane_u &tmux_pane_l &tmux_pane_r
                                                  &trans      &trans      &trans        &mo MEDIA_L
            >;
        };

        /*
         * MACRO LAYER (Layer 4)
         * Additional vim and tmux macros
         */
        macro_layer {
            display-name = "Macro";
            bindings = <
                &trans  &trans  &trans   &trans      &trans     &trans        &trans      &trans   &trans  &trans
                &trans  &trans  &trans   &trans      &trans     &tmux_new     &tmux_prev  &tmux_next &trans &trans
                &trans  &vim_gvd &trans  &trans      &trans     &trans        &tmux_pane_d &tmux_pane_u &trans &trans
                                                  &trans      &trans      &trans        &trans
            >;
        };

        /*
         * MEDIA LAYER (Layer 5)
         * Media controls and brightness
         */
        media {
            display-name = "Media";
            bindings = <
                &trans &bt BT_CLR  &trans   &trans            &kp C_BRI_UP &trans &kp C_PREV &kp C_NEXT &kp C_PLAY_PAUSE &trans
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp C_BRI_DN &trans &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &trans
                &trans  &trans  &trans   &trans      &trans     &trans      &trans      &trans   &trans  &trans
                                                  &trans      &trans      &trans        &trans
            >;
        };

        /*

        num_layer {
            bindings = <
                &kp LBKT   &kp N7     &kp N8      &kp N9          &kp RBKT      &trans          &trans         &trans      &trans     &trans
                &kp SEMI   &kp N4     &kp N5      &kp N6          &kp EQUAL     &trans          &trans         &trans      &trans     &trans
                &kp GRAVE  &kp N1     &kp N2      &kp N3          &kp BSLH      &trans          &trans         &trans      &trans     &trans
                                                  &kp N0          &kp MINUS     &trans          &trans
            >;
        };

        sym_layer {
            bindings = <
                &kp LBRC     &kp LS(N7)  &kp LS(N8)  &kp LS(N9) &kp RBRC       &trans &trans   &trans    &trans    &trans
                &kp COLON     &kp LS(N4)  &kp LS(N5)  &kp LS(N6) &kp PLUS       &trans &trans   &trans    &trans    &trans
                &kp TILDE     &kp LS(N1)  &kp LS(N2)  &kp LS(N3) &kp LS(BSLH)       &trans &trans   &trans    &trans    &trans
                                                   &kp LS(N0) &kp UNDER   &trans &trans
            >;
        };
        */
    };
};
